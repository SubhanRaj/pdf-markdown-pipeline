APP_NAME="PDF Markdown Pipeline"
APP_ENV=local                  # PRODUCTION: set to 'production'
APP_KEY=
APP_DEBUG=true                 # PRODUCTION: must be 'false' — true leaks stack traces
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pdf_markdown_pipeline
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080         # 7 days, sliding — resets on activity, expires after 7 days idle
SESSION_ENCRYPT=true           # Encrypts session data at rest in the DB — requires APP_KEY
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false    # PRODUCTION (HTTPS): must be 'true' — prevents cookie over plain HTTP
SESSION_EXPIRE_ON_CLOSE=false  # Personal-PC use, not shared kiosks — session persists across browser restarts
SESSION_SAME_SITE=strict       # No cross-site cookie transmission — appropriate for internal-only tool

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUICK_CONVERSION_TTL_HOURS=48

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sends onboarding-link and login-OTP emails. Two supported paths — pick one via MAIL_MAILER,
# nothing else in the app references either directly (Mail::to()->send() only):
#   1. Resend (recommended): MAIL_MAILER=resend, set RESEND_API_KEY below.
#   2. SMTP (NIC/Gmail/etc): MAIL_MAILER=smtp, set MAIL_HOST/PORT/USERNAME/PASSWORD/SCHEME.
# MAIL_MAILER=log (default here) just writes emails to storage/logs/laravel.log — safe default
# until a real key/credentials are set.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@mail.exciseup.in"
MAIL_FROM_NAME="UP Excise Document Vault"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
